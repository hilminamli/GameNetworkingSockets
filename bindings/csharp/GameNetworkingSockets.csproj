<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameNetworkingSockets.CSharp</AssemblyName>
    <RootNamespace>GameNetworkingSockets</RootNamespace>
    <Nullable>disable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <DebugType>embedded</DebugType>
    <NoWarn>1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Release: deterministic build; local source paths in the embedded PDB become /_/,
         so no machine paths end up in shipped DLLs. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>

    <PackageId>GameNetworkingSockets.CSharp</PackageId>
    <Version>1.8.0</Version>
    <Authors>hilminamli</Authors>
    <Description>C# bindings for GameNetworkingSockets — Interop and Transport layers. Native libraries built from the fork merged with Valve upstream (native ICE client with STUN+TURN, security fixes). win-x64, linux-x64, and a universal osx (arm64+x86_64) dylib.</Description>
  </PropertyGroup>

  <!-- iOS variant of the wrapper: P/Invoke binds to "__Internal" (static xcframework).
       Build with -p:GnsIos=true; see BUILDING_IOS.md. -->
  <PropertyGroup Condition="'$(GnsIos)' == 'true'">
    <DefineConstants>$(DefineConstants);UNITY_IOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Compile Remove="Tests.P2P\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native/win-x64/GameNetworkingSockets.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="native/linux-x64/libGameNetworkingSockets.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <!-- Universal binary (arm64 + x86_64). Packed under both RIDs so NuGet's runtime
         graph resolves it on either Mac architecture; the file is identical. -->
    <None Include="native/osx-universal/libGameNetworkingSockets.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="native/osx-universal/libGameNetworkingSockets.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="native/osx-universal/libGameNetworkingSockets.dylib" Pack="true" PackagePath="runtimes/osx/native/" />
    <None Include="build/GameNetworkingSockets.CSharp.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
