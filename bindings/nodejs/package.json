{
  "name": "gamenetworkingsockets",
  "version": "0.1.0",
  "description": "Node.js / TypeScript bindings for Valve's GameNetworkingSockets (N-API). Server + client, EventEmitter API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "prebuilds/",
    "README.md"
  ],
  "scripts": {
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "prebuild": "prebuildify --napi --strip --tag-libc",
    "test": "node dist/test/smoke.js"
  },
  "dependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "node-gyp": "^11.0.0",
    "prebuildify": "^6.0.1",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
